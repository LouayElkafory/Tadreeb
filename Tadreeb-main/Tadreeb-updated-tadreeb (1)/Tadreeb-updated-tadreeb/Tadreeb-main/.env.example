OLLAMA_HOST=http://localhost:11434
BASE_MODEL=qwen2.5:7b
FINETUNED_MODEL_NAME=depi-iti-nti-assistant
EMBEDDING_MODEL=nomic-embed-text
VECTOR_DB_PATH=./vector_db

# Model used to write the final grounded answer. Build it from
# 04_finetuning_pipeline/Modelfile, or set this to BASE_MODEL as a fallback.
FINETUNED_MODEL_NAME=depi-iti-nti-assistant:latest
BASE_MODEL=qwen2.5:7b

# Optional: use an external LLM API instead of the local Ollama model for generation
LLM_PROVIDER=ollama
MAX_ANSWER_TOKENS=180
LLM_TEMPERATURE=0.15
LLM_REPEAT_PENALTY=1.15
LLM_API_URL=
LLM_API_KEY=
