OLLAMA_HOST=http://localhost:11434
BASE_MODEL=llama3.1:8b
FINETUNED_MODEL_NAME=depi-iti-nti-assistant
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Where ChromaDB persists its data. In production this MUST point at storage
# that survives restarts/redeploys (a mounted persistent disk/volume) - most
# hosting platforms wipe a plain local path like "./vector_db" on every deploy.
VECTOR_DB_PATH=./vector_db

# Which LLM answers and rewrites queries:
#   ollama  (default) the local fine-tuned Qwen - no key, no internet needed
#   groq    fast, free tier, good Arabic/English - recommended hosted option
#   openai  OpenAI
#   gemini  Google Gemini
#   api     any other OpenAI-compatible endpoint (set LLM_API_URL below)
# Ollama always remains the automatic fallback: if a hosted call fails for any
# reason, the same prompt is retried locally instead of failing the request.
LLM_PROVIDER=ollama

# Key and model for whichever hosted provider is selected above. Never commit a
# real key - .env is gitignored, .env.example is not.
LLM_API_KEY=
# Leave blank to use the provider's default (groq: llama-3.3-70b-versatile,
# openai: gpt-4o-mini, gemini: gemini-2.0-flash).
LLM_MODEL=
LLM_API_TIMEOUT=60

# Optional: run the cheap query-understanding step on a different provider from
# the one that writes the answer - e.g. a fast hosted model for rewriting while
# the grounded answer stays on the local model. Unset = same as LLM_PROVIDER.
QUERY_LLM_PROVIDER=
QUERY_LLM_MODEL=

# Only used when LLM_PROVIDER=api
LLM_API_URL=

# --- Generation (05_generation) ---
# The grounded prompt carries five labelled source blocks plus instructions and
# recent turns. Too small a window makes Ollama silently drop the FRONT of the
# prompt - where the "use only these sources" rules live - and the model then
# answers unconstrained.
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=512
# Factual lookup, not creative writing.
LLM_TEMPERATURE=0.1
# Arabic and mixed Arabic/English questions are matched against a mostly-English
# corpus. The rule-based layer in 03_rag_pipeline/retrieval/query_understanding.py
# handles that on every request at no cost (intent, organisation, named track,
# English term expansion). This setting controls the optional LLM rewrite on top:
#   auto    (default) rewrite only after a first retrieval found nothing
#   always  rewrite up front too, but only when the rules found no anchor
#   off     never rewrite
QUERY_REWRITE=auto

# --- Retrieval tuning (03_rag_pipeline/retrieval) ---
# Defaults are calibrated against 07_evaluation/test_questions.jsonl; re-run
# `python 07_evaluation/evaluate_retrieval.py` after changing the corpus.
# Share of a question's terms that must exist in the corpus before we attempt
# an answer at all. Lower = answers more, refuses less (and hallucinates more).
RETRIEVAL_MIN_COVERAGE=0.65
RETRIEVAL_FALLBACK_COVERAGE=0.50
RETRIEVAL_FALLBACK_SIMILARITY=0.85
RETRIEVAL_MIN_CHUNK_SIMILARITY=0.70
# How strongly chunks from the programme named in the question are preferred.
RETRIEVAL_ORG_MATCH_BOOST=2.0
# Result slots reserved for official documents over curated Q&A material.
RETRIEVAL_RESERVED_DOCUMENT_SLOTS=2
# How strongly web-collected chunks (01_scraping/collect_web_data.py) are ranked
# below the official PDFs. 1.0 = no preference. Lower values keep a public web
# page from displacing the official document when both answer the question.
RETRIEVAL_WEB_SOURCE_WEIGHT=0.7
# How strongly a chunk whose category matches the question's intent is preferred
# (duration question -> duration chunks). 1.0 = category is ignored.
RETRIEVAL_CATEGORY_MATCH_BOOST=1.6
# How strongly a chunk about the exact track/program named in the question is
# preferred ("Data Science track" -> only that track's chunks).
RETRIEVAL_NAME_MATCH_BOOST=2.5
# Optional cross-encoder reranking; unset = disabled. Downloads a second model.
RERANKER_MODEL=

# --- FastAPI backend (06_app) ---
# Comma-separated list of allowed frontend origins for CORS.
# Set this to your deployed Vercel URL(s) in production.
# Both loopback spellings are listed for local dev: a browser treats
# localhost and 127.0.0.1 as different origins, and Vite may print either.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# If true, index the bundled chunks into ChromaDB on startup when it's empty.
# Dev/setup convenience only - keep false in production (see VECTOR_DB_PATH note above).
AUTO_INDEX=false

# Host/port used when running `python main.py` directly (uvicorn CLI flags take
# precedence if you launch with `uvicorn server:app --host ... --port ...`).
HOST=0.0.0.0
PORT=8000
